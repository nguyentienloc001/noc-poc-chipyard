# NoC-PoC: secrets template.
# Cách dùng:  cp .env.example .env  →  điền giá trị  →  source .env (hoặc dùng direnv)
# .env đã nằm trong .gitignore — TUYỆT ĐỐI không commit token.
# Trong GitHub CI: dùng repository secrets, không dùng file này.

export DOCKERHUB_USER=
# Tạo tại: hub.docker.com → Account Settings → Security → New Access Token (scope Read & Write)
export DOCKERHUB_TOKEN=

# Optional: override tên image (mặc định: $DOCKERHUB_USER/noc-poc-chipyard)
# export DOCKER_IMAGE=
